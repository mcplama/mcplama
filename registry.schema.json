{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcplama.com/schemas/registry.schema.json",
  "title": "MCPlama MCP registry",
  "type": "array",
  "items": { "$ref": "#/definitions/server" },
  "definitions": {
    "server": {
      "type": "object",
      "required": ["id", "name", "publisher", "description", "category", "version", "runtime", "transport", "auth_type", "auth_mode", "tools", "requirements"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "official": { "type": "boolean" },
        "version": { "type": "string" },
        "docs_url": { "type": "string", "format": "uri" },
        "runtime": { "enum": ["docker", "npx", "uvx", "remote"] },
        "transport": { "enum": ["stdio", "http", "streamable_http", "sse"] },
        "docker_image": { "type": ["string", "null"] },
        "package": { "type": ["string", "null"] },
        "url": { "type": "string", "format": "uri" },
        "auth_type": { "enum": ["none", "api_token", "api_key", "oauth", "credentials", "basic", "custom"] },
        "auth_mode": { "enum": ["none", "environment", "shared", "per_user"] },
        "remote_auth": { "enum": ["none", "bearer", "header", "oauth"] },
        "auth_header_name": { "type": "string" },
        "user_config_schema": { "type": "array", "items": { "type": "object", "required": ["key", "type"], "properties": { "key": { "type": "string", "minLength": 1 }, "label": { "type": "string" }, "type": { "enum": ["secret", "text", "url", "number", "boolean"] }, "required": { "type": "boolean" } }, "additionalProperties": true } },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requirements": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "docker_args": { "type": "array", "items": { "type": "string" } },
        "system_packages": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "runtime": { "const": "remote" } }, "required": ["runtime"] }, "then": { "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } } } },
        { "if": { "properties": { "runtime": { "enum": ["npx", "uvx"] } }, "required": ["runtime"] }, "then": { "required": ["package"] } },
        { "if": { "properties": { "runtime": { "const": "docker" } }, "required": ["runtime"] }, "then": { "required": ["docker_image"] } },
        { "if": { "properties": { "remote_auth": { "const": "header" } }, "required": ["remote_auth"] }, "then": { "required": ["auth_header_name"] } }
      ],
      "additionalProperties": true
    }
  }
}
