# Local development defaults. Copy this file to .env before using Compose.
# For production, inject these values through your deployment secret manager.

POSTGRES_USER=mcplama
POSTGRES_PASSWORD=
POSTGRES_DB=mcplama

# For docker-compose.dev.yml, use the service hostname "postgres", not
# localhost. Keep the password in this URL synchronized with POSTGRES_PASSWORD.
# Example:
# DATABASE_URL=postgresql+asyncpg://mcplama:change-this-password@postgres:5432/mcplama
# Use URL-encoded credentials if the password contains reserved URL characters.
DATABASE_URL=

# Required outside development.
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
BROKER_TOKEN=
