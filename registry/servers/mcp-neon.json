{
  "id": "mcp-neon",
  "name": "Neon",
  "publisher": "neondatabase",
  "logo_url": "https://github.com/neondatabase.png?size=40&w=25&q=25",
  "description": "MCP server for interacting with Neon Management API and databases",
  "icon": "database",
  "color": "green",
  "category": "Databases & Data Platforms",
  "official": true,
  "version": "2025.6.16",
  "docs_url": "https://github.com/neondatabase-labs/mcp-server-neon",
  "runtime": "docker",
  "transport": "stdio",
  "docker_image": "mcp/neon",
  "package": null,
  "args": [],
  "docker_args": [],
  "container_port": 8000,
  "auth_type": "api_token",
  "auth_mode": "shared",
