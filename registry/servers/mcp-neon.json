    "delete_project",
    "describe_branch",
    "describe_project",
    "describe_table_schema",
    "explain_sql_statement",
    "get_connection_string",
    "get_database_tables",
    "list_projects",
    "prepare_database_migration",
    "prepare_query_tuning",
    "provision_neon_auth",
    "run_sql",
    "run_sql_transaction"
  ],
  "requirements": "Configure: Neon API key"
}