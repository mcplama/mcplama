{
  "id": "mcp-thingsboard",
  "name": "Thingsboard",
  "publisher": "thingsboard",
  "logo_url": "https://github.com/thingsboard.png?size=40&w=25&q=25",
  "description": "Connect your AI workflows to the ThingsBoard IoT Platform through this MCP server. \nEnables LLMs ...",
  "icon": "cpu",
  "color": "blue",
  "category": "Security & Observability",
  "official": true,
  "version": "1.0.0",
  "docs_url": "https://github.com/thingsboard/thingsboard-mcp",
  "runtime": "docker",
  "transport": "stdio",
  "docker_image": "mcp/thingsboard",
  "package": null,
  "args": [],
  "docker_args": [],
  "container_port": 8000,
  "auth_type": "api_token",
  "auth_mode": "shared",
  "user_config_schema": [
    {
      "key": "THINGSBOARD_URL",
      "label": "ThingsBoard URL",
      "type": "text",
      "required": true,
      "placeholder": "https://example.com"
    },
    {
      "key": "THINGSBOARD_API_KEY",
      "label": "ThingsBoard API key",
      "type": "secret",
      "required": true,
      "placeholder": "Enter value"
    }
  ],
  "tools": [
    "findByFrom",
    "findByFromWithRelationType",
    "findByTo",
    "findByToWithRelationType",
    "findInfoByFrom",
    "findInfoByTo",
    "getAdminSettings",
    "getAlarmById",
    "getAlarmInfoById",
    "getAlarmTypes",
    "getAlarms",
    "getAllAlarms",
    "getAllCustomerUsers",
    "getAssetById",
    "getAssetsByEntityGroupId",
    "getAssetsByIds",
    "getAttributeKeys",
    "getAttributeKeysByScope",
    "getAttributes",
    "getAttributesByScope",
    "getCustomerAssets",
    "getCustomerById",
    "getCustomerDevices",
    "getCustomerUsers",
    "getCustomers",
    "getCustomersByEntityGroupId",
    "getDeviceById",
    "getDeviceCredentialsByDeviceId",
    "getDevicesByEntityGroupId",
    "getDevicesByIds",
    "getEntityGroupById",
    "getEntityGroupByOwnerAndNameAndType",
    "getEntityGroupsByIds",
    "getEntityGroupsByOwnerAndType",
    "getEntityGroupsByType",
    "getEntityGroupsForEntity",
    "getHighestAlarmSeverity",
    "getLatestTimeseries",
    "getRelation",
    "getSecuritySettings",
    "getSystemInfo",
    "getTenantAdmins",
    "getTenantAsset",
    "getTenantAssets",
    "getTenantCustomer",
    "getTenantDevice",
    "getTenantDevices",
    "getTimeseries",
    "getTimeseriesKeys",
    "getUsageInfo",
    "getUserAssets",
    "getUserById",
    "getUserCustomers",
    "getUserDevices",
    "getUsers",
    "getUsersByEntityGroupId",
    "getUsersForAssign",
    "saveDeviceAttributes",
    "saveEntityAttributesV1",
    "saveEntityAttributesV2",
    "saveEntityTelemetry",
    "saveEntityTelemetryWithTTL"
  ],
  "requirements": "Configure: ThingsBoard URL and API key"
}